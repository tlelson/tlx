#!/usr/bin/env bash

rds() {
    local help_text="Usage: ${FUNCNAME[0]} [COMMAND] [ARGS] [options]

    Commands:
    list                 List RDS DB clusters as jsonlines
    get CLUSTER_ID       Describe a specific DB cluster
    instance INSTANCE_ID Describe a specific DB instance
    set-master-pass CLUSTER_ID NEW_PASSWORD
                         Set the master user password for a DB cluster (applies immediately)

    Options:
    --help, -h           Display this help message

    Output:
    list: jsonlines of basic DB cluster info (Identifier, Status, Engine, Version, Endpoints).
    get: single JSON object describing the DB cluster.

    Examples:
    rds list | jtbl
    rds get my-aurora-cluster
    "

    if [[ "$1" == "--help" || "$1" == "-h" ]]; then
        echo "$help_text"
        return 0
    fi

    if [ -z "$1" ]; then
        echo "$help_text"
        return 1
    fi

    local command="$1"
    shift

    case "$command" in
    list)
        rds_list "$@"
        ;;
    get)
        rds_get "$@"
        ;;
    instance)
        rds_instance "$@"
        ;;
    set-master-pass)
        rds_set_master_pass "$@"
        ;;
    *)
        echo "Unknown command: $command"
        echo "$help_text"
        return 1
        ;;
    esac
}

rds_list() {
    local help_text="Usage: rds list [options]

    Options:
    --help, -h          Display this help message

    Output:
    jsonlines of basic DB cluster info.
    "

    if [[ "$1" == "--help" || "$1" == "-h" ]]; then
        echo "$help_text"
        return 0
    fi

    if [ -n "$1" ]; then
        echo "Unknown argument: $1"
        echo "$help_text"
        return 1
    fi

    aws rds describe-db-clusters --output json | jq -c '
      .DBClusters[] | {
        DBClusterIdentifier: .DBClusterIdentifier,
        Status: .Status,
        Engine: .Engine,
        EngineVersion: .EngineVersion
      }'
}

rds_get() {
    local help_text="Usage: rds get CLUSTER_ID [options]

    Arguments:
    CLUSTER_ID          The DB cluster identifier or ARN

    Options:
    --help, -h          Display this help message

    Output:
    A single JSON object describing the DB cluster.
    "

    if [[ "$1" == "--help" || "$1" == "-h" ]]; then
        echo "$help_text"
        return 0
    fi

    if [ -z "$1" ]; then
        echo "Error: CLUSTER_ID is required"
        echo "$help_text"
        return 1
    fi

    local cluster_id="$1"

    local describe_output
    if ! describe_output=$(aws rds describe-db-clusters --db-cluster-identifier "$cluster_id" --output json); then
        return 1
    fi

    # Emit the first (and only) cluster object, or error if none found
    echo "$describe_output" | jq -e '.DBClusters | if length > 0 then .[0] else empty end' || {
        echo "Error: Cluster not found: $cluster_id" >&2
        return 1
    }
}

rds_set_master_pass() {
    local help_text="Usage: rds set-master-pass CLUSTER_ID NEW_PASSWORD [options]

    Arguments:
    CLUSTER_ID          The DB cluster identifier or ARN
    NEW_PASSWORD        The new master user password to set

    Options:
    --help, -h          Display this help message

    Behavior:
    Applies the password change immediately to the specified DB cluster.

    Output:
    Prints a confirmation message on success. Returns 0 on success, non-zero on error. No JSON output.

    Example:
    rds set-master-pass my-aurora-cluster 'NewStrongPass123!'
    "

    if [[ "$1" == "--help" || "$1" == "-h" ]]; then
        echo "$help_text"
        return 0
    fi

    if [ -z "$1" ] || [ -z "$2" ]; then
        echo "Error: CLUSTER_ID and NEW_PASSWORD are required"
        echo "$help_text"
        return 1
    fi

    local cluster_id="$1"
    local new_password="$2"

    local modify_output
    if ! modify_output=$(aws rds modify-db-cluster \
        --db-cluster-identifier "$cluster_id" \
        --master-user-password "$new_password" \
        --apply-immediately \
        --output json); then
        echo "Error: Failed to update master user password for cluster '$cluster_id'" >&2
        return 1
    fi

    echo "Updated master user password for cluster '$cluster_id'."
    return 0
}

rds_instance() {
    local help_text="Usage: rds instance INSTANCE_ID [options]

    Arguments:
    INSTANCE_ID         The DB instance identifier or ARN

    Options:
    --help, -h          Display this help message

    Output:
    A single JSON object describing the DB instance.
    "

    if [[ "$1" == "--help" || "$1" == "-h" ]]; then
        echo "$help_text"
        return 0
    fi

    if [ -z "$1" ]; then
        echo "Error: INSTANCE_ID is required"
        echo "$help_text"
        return 1
    fi

    local instance_id="$1"

    local describe_output
    if ! describe_output=$(aws rds describe-db-instances --db-instance-identifier "$instance_id" --output json); then
        return 1
    fi

    # Emit the first (and only) instance object, or error if none found
    echo "$describe_output" | jq -e '.DBInstances | if length > 0 then .[0] else empty end' || {
        echo "Error: Instance not found: $instance_id" >&2
        return 1
    }
}

rds "$@"
