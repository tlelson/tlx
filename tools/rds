#!/usr/bin/env bash

rds() {
    local help_text="Usage: ${FUNCNAME[0]} [COMMAND] [ARGS] [options]

    Commands:
    list                 List RDS DB clusters as jsonlines
    get CLUSTER_ID       Describe a specific DB cluster
    instance INSTANCE_ID Describe a specific DB instance
    set-master-pass CLUSTER_ID NEW_PASSWORD
                         Set the master user password for a DB cluster (applies immediately)
    rm CLUSTER_ID [-f|--force]
                         Delete an RDS DB cluster. With --force, disables deletion protection first.

    Options:
    --help, -h           Display this help message

    Output:
    list: jsonlines of basic DB cluster info (Identifier, Status, Engine, Version, Endpoints).
    get: single JSON object describing the DB cluster.

    Examples:
    rds list | jtbl
    rds get my-aurora-cluster
    "

    if [[ "$1" == "--help" || "$1" == "-h" ]]; then
        echo "$help_text"
        return 0
    fi

    if [ -z "$1" ]; then
        echo "$help_text"
        return 1
    fi

    local command="$1"
    shift

    case "$command" in
    list)
        rds_list "$@"
        ;;
    get)
        rds_get "$@"
        ;;
    instance)
        rds_instance "$@"
        ;;
    set-master-pass)
        rds_set_master_pass "$@"
        ;;
    rm)
        rds_rm "$@"
        ;;
    *)
        echo "Unknown command: $command"
        echo "$help_text"
        return 1
        ;;
    esac
}

rds__print_progress_bar() {
    # Args: current total start_epoch message
    local current=$1
    local total=$2
    local start=$3
    local msg=$4
    local width=30
    local percent=0
    if [ "$total" -gt 0 ]; then
        percent=$(( 100 * current / total ))
    fi
    local filled=$(( width * percent / 100 ))
    local empty=$(( width - filled ))
    local elapsed=$(( $(date +%s) - start ))
    local mins=$(( elapsed / 60 ))
    local secs=$(( elapsed % 60 ))
    printf "\r[%.*s%*s] %3d%% (%d/%d) %s | %02dm%02ds" \
        "$filled" "############################################" \
        "$empty" "" \
        "$percent" "$current" "$total" "$msg" "$mins" "$secs"
}

rds__wait_instances_deleted() {
    # Args: instance_ids...
    local ids=("$@")
    local total=${#ids[@]}
    local start_epoch=$(date +%s)

    # Track which ids are done
    local done_map
    declare -A done_map
    local remaining=$total

    # Initial line
    echo "Waiting for DB instances to be deleted..." >&2

    while [ $remaining -gt 0 ]; do
        local deleted=0
        local status_summary=""

        for id in "${ids[@]}"; do
            if [ -n "${done_map[$id]}" ]; then
                deleted=$((deleted + 1))
                continue
            fi

            # Query instance status; if not found, mark as deleted
            local status
            status=$(aws rds describe-db-instances \
                --db-instance-identifier "$id" \
                --query 'DBInstances[0].DBInstanceStatus' \
                --output text 2>/dev/null) || status="NotFound"

            if [ "$status" = "None" ] || [ "$status" = "NoneType" ] || [ "$status" = "" ] || [ "$status" = "NotFound" ]; then
                done_map[$id]=1
                deleted=$((deleted + 1))
                continue
            fi

            # Build a short status summary (limited to 3 entries)
            if [ -z "$status_summary" ]; then
                status_summary="$id=$status"
            else
                # Limit the number of status entries shown to keep the line short
                local shown_count=$(( $(echo "$status_summary" | awk -F, '{print NF}') ))
                if [ $shown_count -lt 3 ]; then
                    status_summary+=" , $id=$status"
                fi
            fi
        done

        rds__print_progress_bar "$deleted" "$total" "$start_epoch" "$status_summary" >&2

        if [ $deleted -ge $total ]; then
            break
        fi

        sleep 5
    done

    # Finish line
    echo >&2
}

rds_list() {
    local help_text="Usage: rds list [options]

    Options:
    --help, -h          Display this help message

    Output:
    jsonlines of basic DB cluster info.
    "

    if [[ "$1" == "--help" || "$1" == "-h" ]]; then
        echo "$help_text"
        return 0
    fi

    if [ -n "$1" ]; then
        echo "Unknown argument: $1"
        echo "$help_text"
        return 1
    fi

    aws rds describe-db-clusters --output json | jq -c '
      .DBClusters[] | {
        DBClusterIdentifier: .DBClusterIdentifier,
        Status: .Status,
        Engine: .Engine,
        EngineVersion: .EngineVersion
      }'
}

rds_get() {
    local help_text="Usage: rds get CLUSTER_ID [options]

    Arguments:
    CLUSTER_ID          The DB cluster identifier or ARN

    Options:
    --help, -h          Display this help message

    Output:
    A single JSON object describing the DB cluster.
    "

    if [[ "$1" == "--help" || "$1" == "-h" ]]; then
        echo "$help_text"
        return 0
    fi

    if [ -z "$1" ]; then
        echo "Error: CLUSTER_ID is required"
        echo "$help_text"
        return 1
    fi

    local cluster_id="$1"

    local describe_output
    if ! describe_output=$(aws rds describe-db-clusters --db-cluster-identifier "$cluster_id" --output json); then
        return 1
    fi

    # Emit the first (and only) cluster object, or error if none found
    echo "$describe_output" | jq -e '.DBClusters | if length > 0 then .[0] else empty end' || {
        echo "Error: Cluster not found: $cluster_id" >&2
        return 1
    }
}

rds_set_master_pass() {
    local help_text="Usage: rds set-master-pass CLUSTER_ID NEW_PASSWORD [options]

    Arguments:
    CLUSTER_ID          The DB cluster identifier or ARN
    NEW_PASSWORD        The new master user password to set

    Options:
    --help, -h          Display this help message

    Behavior:
    Applies the password change immediately to the specified DB cluster.

    Output:
    Prints a confirmation message on success. Returns 0 on success, non-zero on error. No JSON output.

    Example:
    rds set-master-pass my-aurora-cluster 'NewStrongPass123!'
    "

    if [[ "$1" == "--help" || "$1" == "-h" ]]; then
        echo "$help_text"
        return 0
    fi

    if [ -z "$1" ] || [ -z "$2" ]; then
        echo "Error: CLUSTER_ID and NEW_PASSWORD are required"
        echo "$help_text"
        return 1
    fi

    local cluster_id="$1"
    local new_password="$2"

    local modify_output
    if ! modify_output=$(aws rds modify-db-cluster \
        --db-cluster-identifier "$cluster_id" \
        --master-user-password "$new_password" \
        --apply-immediately \
        --output json); then
        echo "Error: Failed to update master user password for cluster '$cluster_id'" >&2
        return 1
    fi

    echo "Updated master user password for cluster '$cluster_id'."
    return 0
}

rds_rm() {
    local help_text="Usage: rds rm CLUSTER_ID [options]

    Arguments:
    CLUSTER_ID          The DB cluster identifier or ARN

    Options:
    --help, -h          Display this help message
    --force, -f         Disable deletion protection and delete cluster instances before deleting

    Behavior:
    Deletes the specified DB cluster. If --force is provided and deletion protection is enabled,
    it is disabled first (applies immediately). Also deletes all DB instances in the cluster
    before deleting the cluster, showing a progress bar while waiting for instance deletions.
    The final snapshot is skipped.

    Output:
    Prints a confirmation message on success. Returns 0 on success, non-zero on error.
    "

    # Help handling
    if [[ "$1" == "--help" || "$1" == "-h" ]]; then
        echo "$help_text"
        return 0
    fi

    # Argument parsing: require cluster_id first
    if [ -z "$1" ]; then
        echo "Error: CLUSTER_ID is required"
        echo "$help_text"
        return 1
    fi

    local cluster_id="$1"
    shift

    local force="false"
    if [ -n "$1" ]; then
        case "$1" in
            -f|--force)
                force="true"
                shift
                ;;
            -h|--help)
                echo "$help_text"
                return 0
                ;;
            *)
                echo "Unknown argument: $1"
                echo "$help_text"
                return 1
                ;;
        esac
    fi

    # Describe cluster to check existence and deletion protection
    local describe_output cluster_json deletion_protection
    if ! describe_output=$(aws rds describe-db-clusters --db-cluster-identifier "$cluster_id" --output json); then
        return 1
    fi

    if ! cluster_json=$(echo "$describe_output" | jq -e '.DBClusters | if length > 0 then .[0] else empty end'); then
        echo "Error: Cluster not found: $cluster_id" >&2
        return 1
    fi

    deletion_protection=$(echo "$cluster_json" | jq -r '.DeletionProtection // false')

    if [ "$deletion_protection" = "true" ] && [ "$force" != "true" ]; then
        echo "Error: Deletion protection is enabled for '$cluster_id'. Re-run with --force to disable and delete." >&2
        return 1
    fi

    # Disable deletion protection if requested
    if [ "$deletion_protection" = "true" ] && [ "$force" = "true" ]; then
        # AWS CLI boolean flags use --flag to enable and --no-flag to disable.
        # Passing "--deletion-protection false" causes: "Unknown options: false".
        if ! aws rds modify-db-cluster \
            --db-cluster-identifier "$cluster_id" \
            --no-deletion-protection \
            --apply-immediately \
            --output json >/dev/null; then
            echo "Error: Failed to disable deletion protection for cluster '$cluster_id'" >&2
            return 1
        fi
    fi

    # If forcing, delete all DB instances in the cluster first
    if [ "$force" = "true" ]; then
        # Extract instance identifiers from the cluster description
        mapfile -t instance_ids < <(echo "$cluster_json" | jq -r '.DBClusterMembers[]?.DBInstanceIdentifier // empty')
        if [ ${#instance_ids[@]} -gt 0 ]; then
            echo "Deleting ${#instance_ids[@]} DB instance(s) in cluster '$cluster_id'..." >&2
            for instance_id in "${instance_ids[@]}"; do
                # Initiate deletion; if it's already deleting or gone, ignore errors and proceed to wait
                if ! aws rds delete-db-instance --db-instance-identifier "$instance_id" >/dev/null 2>&1; then
                    echo "Warning: Failed to initiate delete for instance '$instance_id'. It may already be deleting." >&2
                fi
            done

            # Wait with a progress bar until all instances are deleted
            rds__wait_instances_deleted "${instance_ids[@]}"
        fi
    fi

    # Delete the cluster (skip final snapshot)
    if ! aws rds delete-db-cluster \
        --db-cluster-identifier "$cluster_id" \
        --skip-final-snapshot \
        --output json >/dev/null; then
        echo "Error: Failed to delete cluster '$cluster_id'" >&2
        return 1
    fi

    echo "Deleted DB cluster '$cluster_id'."
    return 0
}

rds_instance() {
    local help_text="Usage: rds instance INSTANCE_ID [options]

    Arguments:
    INSTANCE_ID         The DB instance identifier or ARN

    Options:
    --help, -h          Display this help message

    Output:
    A single JSON object describing the DB instance.
    "

    if [[ "$1" == "--help" || "$1" == "-h" ]]; then
        echo "$help_text"
        return 0
    fi

    if [ -z "$1" ]; then
        echo "Error: INSTANCE_ID is required"
        echo "$help_text"
        return 1
    fi

    local instance_id="$1"

    local describe_output
    if ! describe_output=$(aws rds describe-db-instances --db-instance-identifier "$instance_id" --output json); then
        return 1
    fi

    # Emit the first (and only) instance object, or error if none found
    echo "$describe_output" | jq -e '.DBInstances | if length > 0 then .[0] else empty end' || {
        echo "Error: Instance not found: $instance_id" >&2
        return 1
    }
}

rds "$@"
