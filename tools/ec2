#!/usr/bin/env bash

## EC2 Tools
#
# Tools for managing EC2 instances.

_ec2_list() {
    # Describes EC2 instances, showing ID, Name, State, Public IP, and Private IP.
    local help_text="Usage: ec2 list [options]
    Lists EC2 instances with their ID, Name, State, Public IP, and Private IP.

    Returns jsonlines.

    Options:
    --help       Display this help message

    Examples:
    ec2 list | jtbl
    "

    if [[ "$*" == *"--help"* ]]; then
        echo "$help_text"
        return 0
    fi

    aws --output json ec2 describe-instances | jq -c '
        .Reservations[].Instances[] | {
            InstanceId: .InstanceId,
            Name: (([.Tags[]? | select(.Key=="Name") | .Value] | first) | if . == null then "" else . end),
            InstanceType: .InstanceType,
            State: .State.Name,
            PublicIpAddress: (if .PublicIpAddress == null then "" else .PublicIpAddress end),
            PrivateIpAddress: (if .PrivateIpAddress == null then "" else .PrivateIpAddress end),
            SecurityGroupIds: [.SecurityGroups[]?.GroupId]
        }
    '
}

_ec2_start() {
    # Starts an EC2 instance.
    local help_text="Usage: ec2 start <instance-id> [options]
    Starts the specified EC2 instance.

    Arguments:
    instance-id  The ID of the EC2 instance to start.

    Options:
    --help       Display this help message

    Examples:
    ec2 start i-0123456789abcdef0
    "

    if [[ "$1" == "--help" ]]; then
        echo "$help_text"
        return 0
    fi
    if [[ -z "$1" ]]; then # Check for missing instance-id separately
        echo "$help_text"  # Show help if instance-id is missing
        return 1
    fi

    local instance_id="$1"
    aws ec2 start-instances --instance-ids "${instance_id}" >/dev/null 2>&1
}

_ec2_stop() {
    # Stops an EC2 instance.
    local help_text="Usage: ec2 stop <instance-id> [options]
    Stops the specified EC2 instance.

    Arguments:
    instance-id  The ID of the EC2 instance to stop.

    Options:
    --help       Display this help message

    Examples:
    ec2 stop i-0123456789abcdef0
    "

    if [[ "$1" == "--help" ]]; then
        echo "$help_text"
        return 0
    fi
    if [[ -z "$1" ]]; then # Check for missing instance-id separately
        echo "$help_text"  # Show help if instance-id is missing
        return 1
    fi

    local instance_id="$1"
    aws ec2 stop-instances --instance-ids "${instance_id}" >/dev/null 2>&1
}

_ec2_list_security_groups() {
    # Lists security groups with their ID, Name, and Description.
    local help_text="Usage: ec2 sg-list [options]
    Lists security groups with their ID, Name, and Description.

    Returns jsonlines.

    Options:
    --help       Display this help message

    Examples:
    ec2 sg-list | jtbl
    "

    if [[ "$*" == *"--help"* ]]; then
        echo "$help_text"
        return 0
    fi

    aws --output json ec2 describe-security-groups | jq -c '.SecurityGroups[] | {GroupId, GroupName, Description}'
}

_ec2_list_security_group_rules() {
    # Lists rules for a specific security group or all rules.
    local help_text="Usage: ec2 sg-rules [security-group-id] [options]
    If a security-group-id is provided, all rules for that group are returned.
    Otherwise, all rules for all security groups are returned.

    Arguments:
    security-group-id   Optional. The ID of the security group (e.g., sg-XXXX).

    Options:
    --help              Display this help message

    Examples:
    ec2 sg-rules sg-0123456789abcdef0 | jtbl
    ec2 sg-rules | jtbl
    "

    local sg_id=""

    # Process arguments: first non-option arg is sg_id
    for arg in "$@"; do
        if [[ "$arg" == "--help" ]]; then
            echo "$help_text"
            return 0
        elif [[ ! "$arg" == --* ]] && [[ -z "$sg_id" ]]; then
            sg_id="$arg"
        fi
    done

    local cmd="aws --output json ec2 describe-security-group-rules"
    if [ -n "$sg_id" ]; then
        cmd+=" --filters Name=group-id,Values=$sg_id"
    fi

    # Execute the constructed command string
    # A more detailed jq filter like in misc.sh can be used if specific fields are preferred:
    eval "$cmd" | jq -c '.SecurityGroupRules[] | {
            SecurityGroupRuleId,
            GroupId,
            Direction: (if .IsEgress == true then "Out" else "In" end),
            Proto: .IpProtocol,
            From: .FromPort,
            To: .ToPort,
            Target: (if .CidrIpv4 != null then .CidrIpv4 elif .CidrIpv6 != null then .CidrIpv6 elif .PrefixListId != null then .PrefixListId elif .ReferencedGroupInfo != null then .ReferencedGroupInfo.GroupId else null end)
        }'
}

_ec2_sg_rule_add() {
    # Adds a rule to a security group.
    local help_text
    read -r -d '' help_text <<'EOF'
Usage: ec2 sg-rule-add <json-rule-spec> [options]
    Adds an inbound or outbound rule to the specified security group.

    Arguments:
    json-rule-spec  A JSON string defining the rule. See examples for structure.
                    The JSON string must be properly escaped for shell arguments,
                    typically by enclosing it in single quotes.

    Options:
    --help          Display this help message

    Examples:
    ec2 sg-rule-add '{
        "GroupId": "sg-0123456789abcdef0",
        "Direction": "In",
        "IpPermissions": [{
            "IpProtocol": "tcp",
            "FromPort": 22,
            "ToPort": 22,
            "IpRanges": [{"CidrIp": "192.168.1.100/32", "Description": "SSH access for my IP"}]
        }]
    }'

    ec2 sg-rule-add '{
        "GroupId": "sg-0123456789abcdef0",
        "Direction": "Out",
        "IpPermissions": [{
            "IpProtocol": "-1",
            "IpRanges": [{"CidrIp": "0.0.0.0/0", "Description": "Allow all outbound"}]
        }]
    }'
EOF

    if [[ "$1" == "--help" ]]; then
        echo "${help_text}"
        return 0
    fi
    if [[ -z "$1" ]]; then
        echo "Error: JSON rule specification is missing."
        echo "$help_text" # Show help if json-rule-spec is missing
        return 1
    fi

    local json_rule_spec="$1"

    # Check if jq is available
    if ! command -v jq &>/dev/null; then
        echo "Error: jq is not installed. Please install jq to use this command."
        return 1
    fi

    # Basic validation of JSON (jq will fail if not valid)
    if ! echo "${json_rule_spec}" | jq empty >/dev/null 2>&1; then
        echo "Error: Invalid JSON provided."
        echo "Attempted to parse: ${json_rule_spec}"
        return 1
    fi

    local group_id
    group_id=$(echo "${json_rule_spec}" | jq -r '.GroupId')
    if [[ -z "${group_id}" || "${group_id}" == "null" ]]; then
        echo "Error: GroupId is missing or null in JSON."
        return 1
    fi

    local direction
    direction=$(echo "${json_rule_spec}" | jq -r '.Direction')
    if [[ "${direction}" != "In" && "${direction}" != "Out" ]]; then
        echo "Error: Direction must be 'In' or 'Out'."
        return 1
    fi

    local ip_permissions
    ip_permissions=$(echo "${json_rule_spec}" | jq -c '.IpPermissions') # Keep as JSON array string
    if [[ -z "${ip_permissions}" || "${ip_permissions}" == "null" || "${ip_permissions}" == "[]" ]]; then
        echo "Error: IpPermissions is missing, null, or empty in JSON."
        return 1
    fi

    local aws_command_action=""
    if [[ "${direction}" == "In" ]]; then
        aws_command_action="authorize-security-group-ingress"
    else
        aws_command_action="authorize-security-group-egress"
    fi

    # Construct and execute the command
    echo "Attempting to add rule to group ${group_id}..."
    if aws ec2 "${aws_command_action}" --group-id "${group_id}" --ip-permissions "${ip_permissions}"; then
        echo "Successfully added rule to group ${group_id}."
    else
        # AWS CLI usually outputs its own errors to stderr.
        echo "Error adding rule to group ${group_id}. Check AWS CLI output for details."
        return 1
    fi
}

_ec2_amis() {
    # Lists AMIs.
    local help_text="Usage: ec2 amis [options]
    Lists latest amazon linux AMIs for the region.

    Options:
    --help       Display this help message

    Examples:
    ec2 amis | jtbl
    "

    if [[ "$*" == *"--help"* ]]; then
        echo "$help_text"
        return 0
    fi

    aws ec2 describe-images \
        --owners amazon \
        --filters "Name=name,Values=amzn2-ami-hvm-*-x86_64-gp2" \
        --query 'sort_by(Images,&CreationDate)[-1].{ID:ImageId,Name:Name,CreationDate:CreationDate}' \
        --output json

    return 1
}

_ec2_terminate() {
    # Terminates an EC2 instance.
    local help_text="Usage: ec2 terminate <instance-id> [options]
    Terminates the specified EC2 instance.

    Arguments:
    instance-id  The ID of the EC2 instance to terminate.

    Options:
    --help       Display this help message

    Examples:
    ec2 terminate i-0123456789abcdef0
    "

    if [[ "$1" == "--help" ]]; then
        echo "$help_text"
        return 0
    fi
    if [[ -z "$1" ]]; then # Check for missing instance-id separately
        echo "Error: Instance ID is missing."
        echo "$help_text" # Show help if instance-id is missing
        return 1
    fi

    local instance_id="$1"
    echo "Attempting to terminate instance ${instance_id}..."
    if aws ec2 terminate-instances --instance-ids "${instance_id}"; then
        echo "Successfully initiated termination for instance ${instance_id}."
        echo "Note: Termination can take a few minutes to complete."
    else
        echo "Error terminating instance ${instance_id}. Check AWS CLI output for details."
        return 1
    fi
}

_ec2_sg_rule_remove() {
    # Removes a rule from a security group by its rule ID.
    local help_text
    read -r -d '' help_text <<'EOF'
Usage: ec2 sg-rule-remove --rule-id <security-group-rule-id> [options]
    Removes a specific rule from a security group using its ID.

    Arguments:
    --rule-id <security-group-rule-id>  The ID of the security group rule to remove (e.g., sgr-0123456789abcdef0).

    Options:
    --help          Display this help message

    Examples:
    ec2 sg-rule-remove --rule-id sgr-0123456789abcdef0
EOF

    local rule_id=""

    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case "$1" in
        --rule-id)
            if [[ -z "$2" || "$2" == --* ]]; then
                echo "Error: --rule-id requires an argument."
                echo "$help_text"
                return 1
            fi
            rule_id="$2"
            shift 2
            ;;
        --help)
            echo "$help_text"
            return 0
            ;;
        *)
            echo "Error: Unknown option or argument: $1"
            echo "$help_text"
            return 1
            ;;
        esac
    done

    if [[ -z "${rule_id}" ]]; then
        echo "Error: --rule-id is a required argument."
        echo "$help_text"
        return 1
    fi

    # Check if jq is available
    if ! command -v jq &>/dev/null; then
        echo "Error: jq is not installed. Please install jq to use this command."
        return 1
    fi

    # Get rule details to determine GroupId and Direction (IsEgress)
    echo "Fetching details for rule ${rule_id}..."
    local rule_details_json
    rule_details_json=$(aws ec2 describe-security-group-rules --filter "Name=security-group-rule-id,Values=${rule_id}" --output json 2>&1)
    local aws_cli_exit_code=$?

    if [[ ${aws_cli_exit_code} -ne 0 ]]; then
        echo "Error fetching rule details from AWS CLI:"
        echo "${rule_details_json}" # This will contain the error message from AWS CLI
        return 1
    fi

    if [[ -z "${rule_details_json}" || "$(echo "${rule_details_json}" | jq '.SecurityGroupRules | length')" -eq 0 ]]; then
        echo "Error: No rule found with ID ${rule_id}."
        echo "AWS Response: ${rule_details_json}"
        return 1
    fi

    # Ensure we got exactly one rule
    if [[ "$(echo "${rule_details_json}" | jq '.SecurityGroupRules | length')" -ne 1 ]]; then
        echo "Error: Expected 1 rule for ID ${rule_id}, but found $(echo "${rule_details_json}" | jq '.SecurityGroupRules | length')."
        echo "AWS Response: ${rule_details_json}"
        return 1
    fi

    local group_id
    group_id=$(echo "${rule_details_json}" | jq -r '.SecurityGroupRules[0].GroupId')
    local is_egress_str # Store as string first to check for null
    is_egress_str=$(echo "${rule_details_json}" | jq -r '.SecurityGroupRules[0].IsEgress')

    if [[ -z "${group_id}" || "${group_id}" == "null" ]]; then
        echo "Error: Could not determine GroupId for rule ${rule_id}."
        echo "Rule Details: ${rule_details_json}"
        return 1
    fi

    if [[ "${is_egress_str}" == "null" ]]; then
        echo "Error: Could not determine direction (IsEgress) for rule ${rule_id}."
        echo "Rule Details: ${rule_details_json}"
        return 1
    fi

    local aws_command_action=""
    if [[ "${is_egress_str}" == "true" ]]; then
        aws_command_action="revoke-security-group-egress"
    else
        aws_command_action="revoke-security-group-ingress"
    fi

    echo "Attempting to remove rule ${rule_id} from group ${group_id}..."
    if aws ec2 "${aws_command_action}" --group-id "${group_id}" --security-group-rule-ids "${rule_id}"; then
        echo "Successfully removed rule ${rule_id} from group ${group_id}."
    else
        echo "Error removing rule ${rule_id}. Check AWS CLI output for details."
        return 1
    fi
}

_ec2_nacls() {
    # Manages Network ACLs (NACLs).
    local help_text="Usage: ec2 nacls [subnet-id] [options]
    If a subnet-id is provided, NACLs associated with that subnet are shown with detailed rule entries.
    If no subnet-id is provided, a list of all NACLs in the account is returned.

    Arguments:
    subnet-id    Optional. The ID of the subnet to filter NACLs by (e.g., subnet-0123456789abcdef0).

    Options:
    --help       Display this help message

    Examples:
    ec2 nacls subnet-0123456789abcdef0 | jq  # Show NACLs and rules for a specific subnet
    ec2 nacls | jtbl                      # List all NACLs
    "

    local subnet_id=""

    # Process arguments: first non-option arg is subnet_id
    for arg in "$@"; do
        if [[ "$arg" == "--help" ]]; then
            echo "$help_text"
            return 0
        elif [[ ! "$arg" == --* ]] && [[ -z "$subnet_id" ]]; then
            subnet_id="$arg"
        # Allow for other options in the future, though none are currently defined beyond --help
        # elif [[ "$arg" == --* ]]; then
        #    # handle other options if any
        #    :
        fi
    done

    if [ -n "$subnet_id" ]; then
        aws --output json ec2 describe-network-acls \
            --query 'NetworkAcls[].{Entries: Entries}' \
            --filters "Name=association.subnet-id,Values=${subnet_id}" | jq '[.[].Entries[] | {
                CidrBlock,
                Direction: (if .Egress then "Out" else "In" end),
                PortRange: ("\(.PortRange.From) - \(.PortRange.To)"), Protocol, Action: .RuleAction,
                Priority: .RuleNumber
            }] | sort_by(.RuleNumber)'
    else
        aws --output json ec2 describe-network-acls \
            --query 'NetworkAcls[]' | jq '[.[] | {
                Name: (.Tags | map(select(.Key == "Name")) | .[0].Value),
                NetworkAclId: .NetworkAclId, # Added NetworkAclId for clarity
                VpcId, Subnets: [.Associations[].SubnetId],
                IsDefault: .IsDefault # Added IsDefault for more info
            }]'
    fi
}

ec2() {
    local command="$1"
    shift

    case "$command" in
    list)
        _ec2_list "$@"
        ;;
    start)
        _ec2_start "$1"
        ;;
    stop)
        _ec2_stop "$1"
        ;;
    sg-list)
        _ec2_list_security_groups "$@"
        ;;
    sg-rules)
        _ec2_list_security_group_rules "$@"
        ;;
    sg-rule-add)
        _ec2_sg_rule_add "$@" # Pass all args for its own parsing
        ;;
    sg-rule-remove)
        _ec2_sg_rule_remove "$@" # Pass all args for its own parsing
        ;;
    amis)
        _ec2_amis "$@"
        ;;
    terminate)
        _ec2_terminate "$1"
        ;;
    nacls)
        _ec2_nacls "$@"
        ;;
    --help | -h)
        echo "Usage: ec2 <command> [options]"
        echo "Commands:"
        echo "  list         List EC2 instances"
        echo "  start        Start an EC2 instance"
        echo "  stop         Stop an EC2 instance"
        echo "  sg-list      List security groups"
        echo "  sg-rules     List security group rules"
        echo "  sg-rule-add  Add a rule to a security group (JSON spec)"
        echo "  sg-rule-remove Remove a rule from a security group (by rule ID)"
        echo "  amis         List AMIs (tabular)"
        echo "  terminate    Terminate an EC2 instance"
        echo "  nacls        Manage Network ACLs"
        echo ""
        echo "Run 'ec2 <command> --help' for command-specific help."
        return 0 # Ensure help exits with 0
        ;;
    *)
        echo "Unknown command: $command"
        echo "Run 'ec2 --help' for a list of commands."
        return 1
        ;;
    esac
}

# shellcheck disable=SC2068
ec2 "$@"
