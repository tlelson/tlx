#!/usr/bin/env bash

# ECS/ECR helper CLI modeled after tools/rds

ecs() {
    local help_text="Usage: ${FUNCNAME[0]} [COMMAND] [ARGS] [options]

    Commands:
    clusters                    List ECS cluster ARNs
    task-def [TD]               Describe a task definition or list active task definitions
    service [CLUSTER SERVICE]   Describe a service or list all services across clusters
    tasks CLUSTER SERVICE       List running task IDs for a service
    shell CLUSTER SERVICE       Open an interactive /bin/bash shell in a running task
    ecr [REPOSITORY]            List repositories or describe one
    ecr-images REPOSITORY [N]   List up to N latest images (default 10) as jsonlines

    Options:
    --help, -h                  Display this help message

    Examples:
    ecs clusters
    ecs task-def my-family:42
    ecs service my-cluster my-service
    ecs tasks my-cluster my-service
    ecs shell my-cluster my-service
    ecs ecr my-repo
    ecs ecr-images my-repo 20 | jtbl
    "

    if [[ "$1" == "--help" || "$1" == "-h" ]]; then
        echo "$help_text"
        return 0
    fi

    if [ -z "$1" ]; then
        echo "$help_text"
        return 1
    fi

    local command="$1"
    shift

    case "$command" in
    clusters)
        ecs_clusters "$@"
        ;;
    task-def)
        ecs_task_def "$@"
        ;;
    service)
        ecs_service "$@"
        ;;
    tasks)
        ecs_tasks "$@"
        ;;
    shell)
        ecs_shell "$@"
        ;;
    ecr)
        ecs_ecr "$@"
        ;;
    ecr-images)
        ecs_ecr_images "$@"
        ;;
    *)
        echo "Unknown command: $command"
        echo "$help_text"
        return 1
        ;;
    esac
}

# List cluster ARNs
ecs_clusters() {
    local help_text="Usage: ecs clusters [options]

    Options:
    --help, -h          Display this help message
    "

    if [[ "$1" == "--help" || "$1" == "-h" ]]; then
        echo "$help_text"
        return 0
    fi

    if [ -n "$1" ]; then
        echo "Unknown argument: $1"
        echo "$help_text"
        return 1
    fi

    aws --output json ecs list-clusters | jq -r '.clusterArns[]'
}

# Describe a task definition or list task defs
ecs_task_def() {
    local help_text="Usage: ecs task-def [TASK_DEFINITION] [options]

    Arguments:
    TASK_DEFINITION      Optional. family:revision to describe

    Options:
    --help, -h           Display this help message

    Behavior:
    If no task definition is provided a list of active task definitions is returned.
    "

    if [[ "$1" == "--help" || "$1" == "-h" ]]; then
        echo "$help_text"
        return 0
    fi

    if [ -n "$1" ]; then
        aws ecs describe-task-definition --task-definition "$1"
    else
        aws --output json ecs list-task-definitions | jq -r '.taskDefinitionArns[] | sub("^[^/]+/"; "")'
    fi
}

# Describe a service or list services across clusters
ecs_service() {
    local help_text="Usage: ecs service [CLUSTER SERVICE] [options]

    Arguments:
    CLUSTER             ECS cluster name/ARN
    SERVICE             Service family name

    Options:
    --help, -h          Display this help message

    Behavior:
    If no cluster and service are provided, outputs a table of CLUSTER SERVICE pairs.
    "

    if [[ "$1" == "--help" || "$1" == "-h" ]]; then
        echo "$help_text"
        return 0
    fi

    if [ "$#" -ne 2 ]; then
        {
            echo "CLUSTER SERVICE"
            aws --output json ecs list-clusters | jq -r '.clusterArns[]' | \
                xargs -P4 -I {} aws --output json ecs list-services --cluster {} | \
                jq -r '.serviceArns[] | sub("^[^/]+/"; "") | sub("/"; " ")'
        } | column -t
    else
        aws ecs describe-services --cluster "$1" --service "$2"
    fi
}

# List running task IDs for a service
ecs_tasks() {
    local help_text="Usage: ecs tasks CLUSTER SERVICE [options]

    Arguments:
    CLUSTER             ECS cluster name/ARN
    SERVICE             Service family name

    Options:
    --help, -h          Display this help message

    Output:
    One task ID per line for RUNNING tasks.
    "

    if [[ "$1" == "--help" || "$1" == "-h" ]]; then
        echo "$help_text"
        return 0
    fi

    if [ -z "$1" ] || [ -z "$2" ]; then
        echo "Error: CLUSTER and SERVICE are required"
        echo "$help_text"
        return 1
    fi

    aws --output json ecs list-tasks --cluster "$1" \
        --service-name "$2" \
        --desired-status RUNNING | jq -r '.taskArns[] | sub(".*/"; "")'
}

# Open interactive shell in a running task
ecs_shell() {
    local help_text="Usage: ecs shell CLUSTER SERVICE [options]

    Arguments:
    CLUSTER             ECS cluster name/ARN
    SERVICE             Service family name

    Options:
    --help, -h          Display this help message

    Behavior:
    Selects a running task from the service and opens /bin/bash via execute-command.
    "

    if [[ "$1" == "--help" || "$1" == "-h" ]]; then
        echo "$help_text"
        return 0
    fi

    if [ -z "$1" ] || [ -z "$2" ]; then
        echo "Error: CLUSTER and SERVICE are required"
        echo "$help_text"
        return 1
    fi

    local cluster="$1"
    local service="$2"

    local taskID
    if ! taskID=$(ecs_tasks "$cluster" "$service" | head -n1); then
        echo "Error: Unable to determine running task for $cluster $service" >&2
        return 1
    fi

    if [ -z "$taskID" ]; then
        echo "Error: No RUNNING tasks found for $cluster $service" >&2
        return 1
    fi

    aws --output json ecs execute-command \
        --cluster "$cluster" \
        --task "$taskID" \
        --command "/bin/bash" \
        --interactive
}

# List or describe ECR repositories
ecs_ecr() {
    local help_text="Usage: ecs ecr [REPOSITORY] [options]

    Arguments:
    REPOSITORY          Optional. Repository name to describe.

    Options:
    --help, -h          Display this help message
    "

    if [[ "$1" == "--help" || "$1" == "-h" ]]; then
        echo "$help_text"
        return 0
    fi

    if [ -n "$1" ]; then
        aws --output json ecr describe-repositories | jq --arg rn "$1" '.repositories[] | select(.repositoryName==$rn)'
    else
        aws --output json ecr describe-repositories | jq -r '.repositories[].repositoryName'
    fi
}

# List images for a repository as jsonlines
ecs_ecr_images() {
    local help_text="Usage: ecs ecr-images REPOSITORY [COUNT] [options]

    Arguments:
    REPOSITORY          Repository name

    Optional Arguments:
    COUNT               Number of latest images to include (default 10)

    Options:
    --help, -h          Display this help message

    Examples:
    ecs ecr-images repo-name | jtbl
    "

    if [[ "$1" == "--help" || "$1" == "-h" ]]; then
        echo "$help_text"
        return 0
    fi

    if [ -z "$1" ]; then
        echo "Error: REPOSITORY is required"
        echo "$help_text"
        return 1
    fi

    local repo="$1"
    local max_items="${2:-10}"

    aws --output json ecr describe-images --repository-name "$repo" --max-items "$max_items" | jq -c '
      .imageDetails | sort_by(.imagePushedAt) | reverse | .[] | {
        Tags: (if (.imageTags | length) == 0 then null else (.imageTags | join(",")) end),
        PushedAt: .imagePushedAt | sub(":[0-9]{2}\\.[0-9]{6}"; ""),
        LastPulledAt: .lastRecordedPullTime | sub(":[0-9]{2}\\.[0-9]{6}"; ""),
        Digest: .imageDigest
      }'
}

# Entrypoint
ecs "$@"
