#!/usr/bin/env bash

secrets() {
    local help_text="Usage: ${FUNCNAME[0]} [COMMAND] [ARGS] [options]

    Commands:
    list                           List secrets in AWS Secrets Manager
    get SECRET_ID                  Get the value of a secret
    rm SECRET_ID [--force|-f]      Delete a secret (immediately with --force, otherwise with recovery)

    Options:
    --help, -h           Display this help message

    Output:
    list: jsonlines of basic secret info
    get: describe-secret JSON with added SecretValue (parsed if JSON)

    Examples:
    secrets list | jtbl
    secrets get my/secret/name
    secrets rm -f my/secret/name
    "

    if [[ "$1" == "--help" || "$1" == "-h" ]]; then
        echo "$help_text"
        return 0
    fi

    if [ -z "$1" ]; then
        echo "$help_text"
        return 1
    fi

    local command="$1"
    shift

    case "$command" in
    list)
        secrets_list "$@"
        ;;
    get)
        secrets_get "$@"
        ;;
    rm)
        secrets_rm "$@"
        ;;
    *)
        echo "Unknown command: $command"
        echo "$help_text"
        return 1
        ;;
    esac
}

secrets_list() {
    local help_text="Usage: secrets list [options]

    Options:
    --help, -h          Display this help message

    Output:
    jsonlines of basic secret info (Name, CreatedDate, LastAccessedDate, DeletedDate).
    "

    if [[ "$1" == "--help" || "$1" == "-h" ]]; then
        echo "$help_text"
        return 0
    fi

    if [ -n "$1" ]; then
        echo "Unknown argument: $1"
        echo "$help_text"
        return 1
    fi

    aws secretsmanager list-secrets \
        --include-planned-deletion \
        --query 'SecretList[].{Name: Name, CreatedDate: CreatedDate, LastAccessedDate: LastAccessedDate, DeletedDate: DeletedDate}' \
        --output json | jq -c '.[]'
}

secrets_get() {
    local help_text="Usage: secrets get SECRET_ID [options]

    Arguments:
    SECRET_ID           The name or ARN of the secret

    Options:
    --help, -h          Display this help message

    Output:
    JSON of describe-secret with an added field SecretValue. If the value is JSON, SecretValue is parsed JSON; otherwise it is the raw string. Binary secrets are returned as base64 string.
    "

    if [[ "$1" == "--help" || "$1" == "-h" ]]; then
        echo "$help_text"
        return 0
    fi

    if [ -z "$1" ]; then
        echo "Error: SECRET_ID is required"
        echo "$help_text"
        return 1
    fi

    local secret_id="$1"

    # Always describe the secret first
    local describe_output
    if ! describe_output=$(aws secretsmanager describe-secret --secret-id "$secret_id" --output json); then
        return 1
    fi

    # Attempt to fetch the secret value (string preferred; fallback to binary)
    local value=""
    local secret_string secret_binary
    secret_string=$(aws secretsmanager get-secret-value --secret-id "$secret_id" --query SecretString --output text 2>/dev/null)
    if [ -n "$secret_string" ] && [ "$secret_string" != "None" ]; then
        value="$secret_string"
    else
        secret_binary=$(aws secretsmanager get-secret-value --secret-id "$secret_id" --query SecretBinary --output text 2>/dev/null)
        if [ -n "$secret_binary" ] && [ "$secret_binary" != "None" ]; then
            value="$secret_binary"
        fi
    fi

    if [ -n "$value" ]; then
        echo "$describe_output" | jq --arg value "$value" '. + {SecretValue: ($value | fromjson? // $value)}'
    else
        # Could not retrieve secret value (permissions or other issue); return describe info
        echo "$describe_output" | jq
    fi
}

secrets_rm() {
    local help_text="Usage: secrets rm SECRET_ID [options]

    Arguments:
    SECRET_ID           The name or ARN of the secret to delete

    Options:
    --help, -h          Display this help message
    -f, --force         Force immediate deletion without recovery
    -r, --recovery-days DAYS  Set recovery window in days (7-30)

    Output:
    Structured JSON from delete-secret (ARN, Name, DeletionDate).
    "

    local secret_id=""
    local force_delete=""
    local recovery_days=""

    # Parse args
    while [[ $# -gt 0 ]]; do
        case "$1" in
        --help | -h)
            echo "$help_text"
            return 0
            ;;
        -f | --force)
            force_delete="1"
            shift
            ;;
        -r | --recovery-days)
            if [ -z "$2" ]; then
                echo "Error: $1 requires a DAYS value"
                echo "$help_text"
                return 1
            fi
            recovery_days="$2"
            shift 2
            ;;
        *)
            if [ -z "$secret_id" ]; then
                secret_id="$1"
                shift
            else
                echo "Unknown argument: $1"
                echo "$help_text"
                return 1
            fi
            ;;
        esac
    done

    if [ -z "$secret_id" ]; then
        echo "Error: SECRET_ID is required"
        echo "$help_text"
        return 1
    fi

    if [ -n "$force_delete" ] && [ -n "$recovery_days" ]; then
        echo "Error: --force and --recovery-days are mutually exclusive"
        return 1
    fi

    if [ -n "$force_delete" ]; then
        aws secretsmanager delete-secret \
            --secret-id "$secret_id" \
            --force-delete-without-recovery \
            --output json | jq
        return "${PIPESTATUS[0]}"
    fi

    if [ -n "$recovery_days" ]; then
        aws secretsmanager delete-secret \
            --secret-id "$secret_id" \
            --recovery-window-in-days "$recovery_days" \
            --output json | jq
        return "${PIPESTATUS[0]}"
    fi

    # Default: rely on AWS default recovery window (typically 30 days)
    aws secretsmanager delete-secret \
        --secret-id "$secret_id" \
        --output json | jq
    return "${PIPESTATUS[0]}"
}

secrets "$@"
