#!/usr/bin/env bash

usage() {
    cat <<EOF
Usage: secrets [command] [secret-name]

List secrets in AWS Secrets Manager.

If a secret-name is provided, it describes that secret and its value.
Otherwise, it lists all secrets.

Options:
  -h, --help    Display this help message.
EOF
    exit 0
}

secrets() {
    if [[ "$1" == "-h" || "$1" == "--help" ]]; then
        usage
    fi

    if [[ $# -gt 0 ]]; then
        secret_id="$1"
        describe_output=$(aws secretsmanager describe-secret --secret-id "$secret_id" --output json)

        if [[ $? -ne 0 ]]; then
            # describe-secret failed, so exit.
            exit 1
        fi

        secret_value=$(aws secretsmanager get-secret-value --secret-id "$secret_id" --query SecretString --output text 2>/dev/null)

        if [[ $? -eq 0 ]]; then
            echo "$describe_output" | jq --arg value "$secret_value" '. + {SecretValue: ($value | fromjson? // $value)}'
        else
            # get-secret-value failed, just show the describe output
            echo "$describe_output" | jq
        fi
    else
        aws secretsmanager list-secrets \
            --query 'SecretList[].{Name: Name, CreatedDate: CreatedDate, LastAccessedDate: LastAccessedDate}' \
            --output json | jq -c
    fi
}

secrets "$@"
