#!/usr/bin/env bash

secrets__mktemp_file() {
    mktemp "${TMPDIR:-/tmp}/secrets.XXXXXX" 2>/dev/null || mktemp -t secrets
}

secrets__capture_command() {
    local stdout_var="$1"
    local stderr_var="$2"
    shift 2

    local stderr_file
    stderr_file=$(secrets__mktemp_file) || return 1

    local stdout=""
    stdout=$("$@" 2>"$stderr_file")
    local status=$?

    local stderr=""
    stderr=$(cat "$stderr_file")
    rm -f "$stderr_file"

    printf -v "$stdout_var" '%s' "$stdout"
    printf -v "$stderr_var" '%s' "$stderr"

    return "$status"
}

secrets() {
    local help_text="Usage: ${FUNCNAME[0]} [COMMAND] [ARGS] [options]

    Commands:
    list                           List secrets in AWS Secrets Manager
    get SECRET_ID [VERSION]        Get the value of a secret (optionally by version stage)
    rm SECRET_ID [--force|-f]      Delete a secret (immediately with --force, otherwise with recovery)

    Options:
    --help, -h           Display this help message

    Output:
    list: jsonlines of basic secret info
    get: describe-secret JSON with added SecretValue (parsed if JSON) and CurrentVersionId

    Examples:
    secrets list | jtbl
    secrets get my/secret/name
    secrets get my/secret/name AWSPREVIOUS
    secrets rm -f my/secret/name
    "

    if [[ "$1" == "--help" || "$1" == "-h" ]]; then
        echo "$help_text"
        return 0
    fi

    if [ -z "$1" ]; then
        echo "$help_text"
        return 1
    fi

    local command="$1"
    shift

    case "$command" in
    list)
        secrets_list "$@"
        ;;
    get)
        secrets_get "$@"
        ;;
    rm)
        secrets_rm "$@"
        ;;
    *)
        echo "Unknown command: $command"
        echo "$help_text"
        return 1
        ;;
    esac
}

secrets_list() {
    local help_text="Usage: secrets list [options]

    Options:
    --help, -h          Display this help message

    Output:
    jsonlines of basic secret info (Name, CreatedDate, LastAccessedDate, DeletedDate).
    "

    if [[ "$1" == "--help" || "$1" == "-h" ]]; then
        echo "$help_text"
        return 0
    fi

    if [ -n "$1" ]; then
        echo "Unknown argument: $1"
        echo "$help_text"
        return 1
    fi

    aws secretsmanager list-secrets \
        --include-planned-deletion \
        --query 'SecretList[].{Name: Name, CreatedDate: CreatedDate, LastAccessedDate: LastAccessedDate, DeletedDate: DeletedDate}' \
        --output json | jq -c '.[]'
}

secrets_get() {
    local help_text="Usage: secrets get SECRET_ID [VERSION] [options]

    Arguments:
    SECRET_ID           The name or ARN of the secret
    VERSION             Optional version selector: version stage label (e.g. AWSPREVIOUS) or a specific version ID

    Options:
    --help, -h          Display this help message

    Output:
    JSON of describe-secret with added fields:
    - SecretValue: If the value is JSON, SecretValue is parsed JSON; otherwise it is the raw string. Binary secrets are returned as base64 string.
    - CurrentVersionId: The version ID marked with the AWSCURRENT stage.

    Examples:
    secrets get my/secret/name
    secrets get my/secret/name AWSPREVIOUS
    "

    if [[ "$1" == "--help" || "$1" == "-h" ]]; then
        echo "$help_text"
        return 0
    fi

    if [ -z "$1" ]; then
        echo "Error: SECRET_ID is required"
        echo "$help_text"
        return 1
    fi

    local secret_id="$1"
    local version_stage=""

    # Optional positional VERSION (interpreted as version stage label)
    if [ -n "$2" ] && [[ "$2" != --* ]]; then
        version_stage="$2"
        shift 1
    fi

    # Always describe the secret first
    local describe_output
    if ! describe_output=$(aws secretsmanager describe-secret --secret-id "$secret_id" --output json); then
        return 1
    fi

    # Attempt to fetch the secret value (string preferred; fallback to binary)
    local value=""
    local secret_string secret_binary
    local aws_stderr=""
    local first_get_error=""
    local get_failed=0
    # Build optional version args for get-secret-value (stage first)
    local -a version_args=()
    if [ -n "$version_stage" ]; then
        version_args=(--version-stage "$version_stage")
    fi

    if ! secrets__capture_command secret_string aws_stderr aws secretsmanager get-secret-value --secret-id "$secret_id" "${version_args[@]}" --query SecretString --output text; then
        get_failed=1
        if [ -z "$first_get_error" ] && [ -n "$aws_stderr" ]; then
            first_get_error="$aws_stderr"
        fi
    fi
    if [ -n "$secret_string" ] && [ "$secret_string" != "None" ]; then
        value="$secret_string"
    else
        if ! secrets__capture_command secret_binary aws_stderr aws secretsmanager get-secret-value --secret-id "$secret_id" "${version_args[@]}" --query SecretBinary --output text; then
            get_failed=1
            if [ -z "$first_get_error" ] && [ -n "$aws_stderr" ]; then
                first_get_error="$aws_stderr"
            fi
        fi
        if [ -n "$secret_binary" ] && [ "$secret_binary" != "None" ]; then
            value="$secret_binary"
        fi
    fi

    # If nothing returned and a VERSION was provided, try as version-id
    if [ -z "$value" ] && [ -n "$version_stage" ]; then
        if ! secrets__capture_command secret_string aws_stderr aws secretsmanager get-secret-value --secret-id "$secret_id" --version-id "$version_stage" --query SecretString --output text; then
            get_failed=1
            if [ -z "$first_get_error" ] && [ -n "$aws_stderr" ]; then
                first_get_error="$aws_stderr"
            fi
        fi
        if [ -n "$secret_string" ] && [ "$secret_string" != "None" ]; then
            value="$secret_string"
        else
            if ! secrets__capture_command secret_binary aws_stderr aws secretsmanager get-secret-value --secret-id "$secret_id" --version-id "$version_stage" --query SecretBinary --output text; then
                get_failed=1
                if [ -z "$first_get_error" ] && [ -n "$aws_stderr" ]; then
                    first_get_error="$aws_stderr"
                fi
            fi
            if [ -n "$secret_binary" ] && [ "$secret_binary" != "None" ]; then
                value="$secret_binary"
            fi
        fi
    fi

    if [ -n "$value" ]; then
        echo "$describe_output" | jq --arg value "$value" '
            . + {SecretValue: ($value | fromjson? // $value)}
            | . + {CurrentVersionId: ((.VersionIdsToStages // {})
                                        | to_entries
                                        | map(select(.value | index("AWSCURRENT")))
                                        | .[0].key // null)}
        '
    else
        # Could not retrieve secret value (permissions or other issue); return describe info
        echo "$describe_output" | jq '
            . + {CurrentVersionId: ((.VersionIdsToStages // {})
                                        | to_entries
                                        | map(select(.value | index("AWSCURRENT")))
                                        | .[0].key // null)}
        '
        if [ "$get_failed" -ne 0 ] && [ -n "$first_get_error" ]; then
            printf '%s\n' "$first_get_error" >&2
            return 1
        fi
    fi
}

secrets_rm() {
    local help_text="Usage: secrets rm SECRET_ID [options]

    Arguments:
    SECRET_ID           The name or ARN of the secret to delete

    Options:
    --help, -h          Display this help message
    -f, --force         Force immediate deletion without recovery
    -r, --recovery-days DAYS  Set recovery window in days (7-30)

    Output:
    Structured JSON from delete-secret (ARN, Name, DeletionDate).
    "

    local secret_id=""
    local force_delete=""
    local recovery_days=""

    # Parse args
    while [[ $# -gt 0 ]]; do
        case "$1" in
        --help | -h)
            echo "$help_text"
            return 0
            ;;
        -f | --force)
            force_delete="1"
            shift
            ;;
        -r | --recovery-days)
            if [ -z "$2" ]; then
                echo "Error: $1 requires a DAYS value"
                echo "$help_text"
                return 1
            fi
            recovery_days="$2"
            shift 2
            ;;
        *)
            if [ -z "$secret_id" ]; then
                secret_id="$1"
                shift
            else
                echo "Unknown argument: $1"
                echo "$help_text"
                return 1
            fi
            ;;
        esac
    done

    if [ -z "$secret_id" ]; then
        echo "Error: SECRET_ID is required"
        echo "$help_text"
        return 1
    fi

    if [ -n "$force_delete" ] && [ -n "$recovery_days" ]; then
        echo "Error: --force and --recovery-days are mutually exclusive"
        return 1
    fi


    if [ -n "$force_delete" ]; then
        # Ensure true hard delete: handle replicas and pending deletion first
        local describe_output
        if ! describe_output=$(aws secretsmanager describe-secret --secret-id "$secret_id" --output json 2>/dev/null); then
            # If not found, treat as already deleted
            echo '{"Status": "NotFound", "SecretId": '"\"$secret_id\""'}' | jq
            return 0
        fi

        # If secret has replicas, remove them before force delete
        mapfile -t _replicas < <(echo "$describe_output" | jq -r '(.ReplicationStatus // []) | map(.Region) | .[]')
        if [ ${#_replicas[@]} -gt 0 ]; then
            aws secretsmanager remove-regions-from-replication \
                --secret-id "$secret_id" \
                --remove-replica-regions "${_replicas[@]}" >/dev/null 2>&1 || true
        fi

        # If already scheduled for deletion, restore first
        if echo "$describe_output" | jq -e 'has("DeletedDate")' >/dev/null; then
            aws secretsmanager restore-secret --secret-id "$secret_id" >/dev/null 2>&1 || true
        fi

        aws secretsmanager delete-secret \
            --secret-id "$secret_id" \
            --force-delete-without-recovery \
            --output json | jq
        return "${PIPESTATUS[0]}"
    fi
    if [ -n "$recovery_days" ]; then
        aws secretsmanager delete-secret \
            --secret-id "$secret_id" \
            --recovery-window-in-days "$recovery_days" \
            --output json | jq
        return "${PIPESTATUS[0]}"
    fi

    # Default: rely on AWS default recovery window (typically 30 days)
    aws secretsmanager delete-secret \
        --secret-id "$secret_id" \
        --output json | jq
    return "${PIPESTATUS[0]}"
}

secrets "$@"
