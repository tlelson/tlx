sagemaker_notebooks() {
    local help_text="Usage: ${ROOT_CMD} notebooks <command> [args] [options]

    Commands:
    list                 List SageMaker notebook instances as jsonlines
    start NOTEBOOK_INSTANCE_NAME
                         Start a SageMaker notebook instance
    stop NOTEBOOK_INSTANCE_NAME
                         Stop a SageMaker notebook instance
    delete NOTEBOOK_INSTANCE_NAME
                         Delete a SageMaker notebook instance
    rm NOTEBOOK_INSTANCE_NAME
                         Alias for delete

    Options:
    --help, -h           Display this help message

    Examples:
    ${ROOT_CMD} notebooks list | jtbl
    ${ROOT_CMD} notebooks start my-notebook
    ${ROOT_CMD} notebooks stop my-notebook
    ${ROOT_CMD} notebooks delete my-notebook
    ${ROOT_CMD} nb list
    ${ROOT_CMD} notebook-instances rm my-notebook

    You can also invoke this tool as '${ALT_CMD}'.
    "

    case "$1" in
    list)
        shift
        sagemaker_notebooks_list "$@"
        ;;
    start)
        shift
        sagemaker_notebooks_start "$@"
        ;;
    stop)
        shift
        sagemaker_notebooks_stop "$@"
        ;;
    delete | rm)
        shift
        sagemaker_notebooks_delete "$@"
