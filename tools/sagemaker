#!/usr/bin/env bash

ROOT_CMD=${TLX_SAGEMAKER_CMD:-$(basename "$0")}
case "$ROOT_CMD" in
sm)
    ROOT_CMD="sm"
    ALT_CMD="sagemaker"
    ;;
sagemaker | sagemaker.sh)
    ROOT_CMD="sagemaker"
    ALT_CMD="sm"
    ;;
*)
    ROOT_CMD="sagemaker"
    ALT_CMD="sm"
    ;;
esac

sagemaker_endpoints_list() {
    local invocation="${ROOT_CMD} endpoints list"
    local help_text="Usage: ${invocation} [options]

    List SageMaker endpoints.

    Options:
    --help, -h          Display this help message

    Output:
    jsonlines of endpoint summary fields (EndpointName, EndpointStatus, EndpointConfigName, CreationTime, LastModifiedTime).

    Examples:
    ${invocation} | jtbl
    "

    if [[ "$1" == "--help" || "$1" == "-h" ]]; then
        echo "$help_text"
        return 0
    fi

    if [[ -n "$1" ]]; then
        echo "Unknown argument: $1" >&2
        echo "$help_text" >&2
        return 1
    fi

    local output
    if ! output=$(aws --output json sagemaker list-endpoints); then
        return 1
    fi

    local endpoint_name
    while IFS= read -r endpoint_name; do
        [ -n "$endpoint_name" ] || continue

        aws --output json sagemaker describe-endpoint \
            --endpoint-name "$endpoint_name" | jq -c '{
                EndpointName,
                EndpointStatus,
                EndpointConfigName,
                CreationTime,
                LastModifiedTime
            }' || return 1
    done < <(echo "$output" | jq -r '.Endpoints[]?.EndpointName')
}

sagemaker_endpoints_rm() {
    local invocation="${ROOT_CMD} endpoints rm"
    local help_text="Usage: ${invocation} ENDPOINT_NAME [options]

    Arguments:
    ENDPOINT_NAME       The SageMaker endpoint name

    Options:
    --help, -h          Display this help message

    Behavior:
    Sends a delete request for the specified SageMaker endpoint.

    Output:
    Prints a confirmation message on success.

    Examples:
    ${invocation} my-endpoint
    "

    if [[ "$1" == "--help" || "$1" == "-h" ]]; then
        echo "$help_text"
        return 0
    fi

    if [[ -z "$1" ]]; then
        echo "Error: ENDPOINT_NAME is required" >&2
        echo "$help_text" >&2
        return 1
    fi

    if [[ -n "$2" ]]; then
        echo "Error: too many arguments" >&2
        echo "$help_text" >&2
        return 1
    fi

    local endpoint_name="$1"
    if ! aws sagemaker delete-endpoint --endpoint-name "$endpoint_name"; then
        return 1
    fi

    echo "Delete requested for SageMaker endpoint '$endpoint_name'."
}

sagemaker_endpoints() {
    local help_text="Usage: ${ROOT_CMD} endpoints <command> [args] [options]

    Commands:
    list                 List SageMaker endpoints as jsonlines
    rm ENDPOINT_NAME     Delete a SageMaker endpoint

    Options:
    --help, -h           Display this help message

    Examples:
    ${ROOT_CMD} endpoints list | jtbl
    ${ROOT_CMD} endpoints rm my-endpoint

    You can also invoke this tool as '${ALT_CMD}'.
    "

    case "$1" in
    list)
        shift
        sagemaker_endpoints_list "$@"
        ;;
    rm)
        shift
        sagemaker_endpoints_rm "$@"
        ;;
    --help | -h | "")
        echo "$help_text"
        if [[ -z "$1" ]]; then
            return 1
        fi
        return 0
        ;;
    *)
        echo "Unknown command: $1" >&2
        echo "$help_text" >&2
        return 1
        ;;
    esac
}

sagemaker_notebooks_list() {
    local invocation="${ROOT_CMD} notebooks list"
    local help_text="Usage: ${invocation} [options]

    List SageMaker notebook instances.

    Options:
    --help, -h          Display this help message

    Output:
    jsonlines of notebook instance summary fields (NotebookInstanceName, NotebookInstanceStatus, InstanceType, Url, CreationTime, LastModifiedTime).

    Examples:
    ${invocation} | jtbl
    "

    if [[ "$1" == "--help" || "$1" == "-h" ]]; then
        echo "$help_text"
        return 0
    fi

    if [[ -n "$1" ]]; then
        echo "Unknown argument: $1" >&2
        echo "$help_text" >&2
        return 1
    fi

    aws --output json sagemaker list-notebook-instances | jq -c '
      .NotebookInstances[]? | {
        NotebookInstanceName,
        NotebookInstanceStatus,
        InstanceType,
        Url,
        CreationTime,
        LastModifiedTime
      }'
}

sagemaker_notebooks_status() {
    local notebook_instance_name="$1"

    aws sagemaker describe-notebook-instance \
        --notebook-instance-name "$notebook_instance_name" \
        --query 'NotebookInstanceStatus' \
        --output text
}

sagemaker_notebooks_prepare_delete() {
    local notebook_instance_name="$1"
    local stop_requested=""
    local previous_status=""
    local status

    while true; do
        if ! status=$(sagemaker_notebooks_status "$notebook_instance_name"); then
            return 1
        fi

        if [[ "$status" != "$previous_status" ]]; then
            echo "SageMaker notebook instance '$notebook_instance_name' status: $status" >&2
            previous_status="$status"
        fi

        case "$status" in
        Stopped | Failed)
            return 0
            ;;
        Deleting)
            echo "Delete is already in progress for SageMaker notebook instance '$notebook_instance_name'." >&2
            return 2
            ;;
        InService)
            if [[ -z "$stop_requested" ]]; then
                echo "Stopping SageMaker notebook instance '$notebook_instance_name' before delete." >&2
                if ! aws sagemaker stop-notebook-instance \
                    --notebook-instance-name "$notebook_instance_name"; then
                    return 1
                fi
                stop_requested="1"
            fi
            ;;
        Pending | Stopping | Updating)
            ;;
        *)
            echo "Error: cannot delete SageMaker notebook instance '$notebook_instance_name' while status is '$status'" >&2
            return 1
            ;;
        esac

        sleep 10
    done
}

sagemaker_notebooks_delete() {
    local invocation="${ROOT_CMD} notebooks delete"
    local help_text="Usage: ${invocation} NOTEBOOK_INSTANCE_NAME [options]

    Arguments:
    NOTEBOOK_INSTANCE_NAME
                         The SageMaker notebook instance name

    Options:
    --help, -h           Display this help message

    Behavior:
    Stops the SageMaker notebook instance if needed, waits until it can be deleted, then sends a delete request.

    Output:
    Prints progress to stderr and a confirmation message on success.

    Examples:
    ${invocation} my-notebook
    "

    if [[ "$1" == "--help" || "$1" == "-h" ]]; then
        echo "$help_text"
        return 0
    fi

    if [[ -z "$1" ]]; then
        echo "Error: NOTEBOOK_INSTANCE_NAME is required" >&2
        echo "$help_text" >&2
        return 1
    fi

    if [[ -n "$2" ]]; then
        echo "Error: too many arguments" >&2
        echo "$help_text" >&2
        return 1
    fi

    local notebook_instance_name="$1"
    sagemaker_notebooks_prepare_delete "$notebook_instance_name"
    local prepare_result=$?
    if [[ "$prepare_result" -eq 2 ]]; then
        return 0
    fi
    if [[ "$prepare_result" -ne 0 ]]; then
        return "$prepare_result"
    fi

    if ! aws sagemaker delete-notebook-instance \
        --notebook-instance-name "$notebook_instance_name"; then
        return 1
    fi

    echo "Delete requested for SageMaker notebook instance '$notebook_instance_name'."
}

