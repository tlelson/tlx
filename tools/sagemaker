sagemaker() {
    local help_text="Usage: ${ROOT_CMD} <command> [args] [options]

    Commands:
    endpoints            Manage SageMaker endpoints
    notebooks            Manage SageMaker notebook instances
    nb                   Alias for notebooks
    notebook-instances   Alias for notebooks
    endpoint-config      Manage SageMaker endpoint configurations

    Options:
    --help, -h           Display this help message

    Examples:
    ${ROOT_CMD} endpoints list
    ${ROOT_CMD} endpoints rm my-endpoint
    ${ROOT_CMD} notebooks list
    ${ROOT_CMD} notebooks start my-notebook
    ${ROOT_CMD} notebooks stop my-notebook
    ${ROOT_CMD} notebooks delete my-notebook
    ${ROOT_CMD} nb list
    ${ROOT_CMD} endpoint-config show my-endpoint-config

    Short alias:
    ${ALT_CMD}
    "

    case "$1" in
    endpoints)
        shift
        sagemaker_endpoints "$@"
        ;;
    notebooks | nb | notebook-instances)
        shift
        sagemaker_notebooks "$@"
        ;;
    endpoint-config)
        shift
        sagemaker_endpoint_config "$@"
        ;;
    --help | -h | "")
        echo "$help_text"
        if [[ -z "$1" ]]; then
            return 1
        fi
        return 0
        ;;
    *)
        echo "Unknown command: $1" >&2
        echo "$help_text" >&2
        return 1
        ;;
    esac
}

sagemaker "$@"
