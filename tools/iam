#!/usr/bin/env bash

# Function to display help for the subcommands
iam_help() {
    echo "Usage: iam <command> [options]"
    echo ""
    echo "Commands:"
    echo "  role         List IAM roles or show details of a specific role."
    echo "               Run 'iam role --help' for more details."
    echo "  role-policy  Show details of a role policy."
    echo "               Run 'iam role-policy --help' for more details."
    echo "  policy       List IAM policies or show the policy document of a specific policy."
    echo "               Run 'iam policy --help' for more details."
    echo ""
    echo "Options:"
    echo "  -h, --help   Display this help message."
}

iam_role_policy() {
    local help_text="Usage: iam role-policy <role_name> <policy_name>

    Show details of a role policy. This is distinct from an attached policy. Use 'iam policy' for those.

    Arguments:
    role_name     Name of the IAM role
    policy_name   Name of the policy

    Options:
    --help        Display this help message"

    if [[ "$*" == *"--help"* ]]; then
        echo "$help_text"
        return 0
    fi

    if [ "$#" -ne 2 ]; then
        echo "$help_text"
        return 1
    fi

    aws --output json iam get-role-policy --role-name "$1" --policy-name "$2" | jq
}

iam_role_update() {
    local help_text="Usage: iam role update <role_name> <update_json_path>

    Update operations are driven by keys present in the provided JSON file.
    - If 'AssumeRolePolicyDocument' is present, update the role's trust policy.
    - If 'InlinePolicy' is present, add or update a single inline policy on the role.
    If none of the supported keys are present, no changes are made.

    Arguments:
    role_name     Name of the IAM role
    json_path     Path to JSON update document

    Options:
    --help        Display this help message

    Output:
    Confirmation message on success or AWS CLI error output.

    Examples:
    iam role update my-app-role ./role-update.json

    Wrapper document (role-update.json):
    {
      \"AssumeRolePolicyDocument\": {
        \"Version\": \"2012-10-17\",
        \"Statement\": [
          {
            \"Effect\": \"Allow\",
            \"Principal\": { \"Service\": \"ecs-tasks.amazonaws.com\" },
            \"Action\": \"sts:AssumeRole\"
          }
        ]
      },
      \"InlinePolicy\": {
        \"PolicyName\": \"AllowS3Read\",
        \"PolicyDocument\": {
          \"Version\": \"2012-10-17\",
          \"Statement\": [
            {
              \"Effect\": \"Allow\",
              \"Action\": [\"s3:GetObject\"],
              \"Resource\": [\"arn:aws:s3:::my-bucket/*\"]
            }
          ]
        }
      }
    }

    Notes:
    - The JSON must be a valid wrapper document; supported keys are .AssumeRolePolicyDocument and .InlinePolicy.
    - The inner trust policy must be a valid IAM trust policy document.
    - For InlinePolicy, both PolicyName and PolicyDocument are required.
    - Use \"Principal\" appropriate to your use-case (e.g. {\"AWS\": \"arn:aws:iam::123456789012:root\"} or OIDC/SAML providers).
    - Optional conditions can be added under \"Condition\" in a statement."

    if [[ "$*" == *"--help"* ]]; then
        echo "$help_text"
        return 0
    fi

    if [ "$#" -ne 2 ]; then
        echo "$help_text"
        return 1
    fi

    local role_name="$1"
    local json_path="$2"

    if [ ! -f "$json_path" ]; then
        echo "File not found: $json_path" >&2
        return 1
    fi

    # Validate JSON
    if ! jq empty "$json_path" >/dev/null 2>&1; then
        echo "Invalid JSON: $json_path" >&2
        return 1
    fi

    local did_any_change=0
    local op_status=0

    # Only update trust policy if wrapper key is present
    if jq -e 'has("AssumeRolePolicyDocument")' "$json_path" >/dev/null 2>&1; then
        # Extract the trust policy document
        local tmp_trust
        tmp_trust=$(mktemp 2>/dev/null || mktemp -t trustdoc)
        if ! jq '.AssumeRolePolicyDocument' "$json_path" >"$tmp_trust"; then
            echo "Failed to extract AssumeRolePolicyDocument from $json_path" >&2
            [ -f "$tmp_trust" ] && rm -f "$tmp_trust"
            return 1
        fi
        # Validate extracted JSON
        if ! jq empty "$tmp_trust" >/dev/null 2>&1; then
            echo "Extracted AssumeRolePolicyDocument is not valid JSON" >&2
            rm -f "$tmp_trust"
            return 1
        fi

        aws iam update-assume-role-policy \
            --role-name "$role_name" \
            --policy-document "file://$tmp_trust"

        local status=$?
        if [ $status -eq 0 ]; then
            echo "Updated trust policy for role '$role_name' from '$json_path' (.AssumeRolePolicyDocument)"
            rm -f "$tmp_trust" 2>/dev/null || true
            did_any_change=1
        else
            rm -f "$tmp_trust" 2>/dev/null || true
            op_status=$status
        fi
    fi

    # Add or update a single inline policy if provided as InlinePolicy
    if jq -e 'has("InlinePolicy")' "$json_path" >/dev/null 2>&1; then
        local policy_name
        policy_name=$(jq -r '.InlinePolicy.PolicyName // empty' "$json_path")
        if [ -z "$policy_name" ]; then
            echo "InlinePolicy.PolicyName is required" >&2
            return 1
        fi

        local tmp_inline
        tmp_inline=$(mktemp 2>/dev/null || mktemp -t inlinepol)
        if ! jq '.InlinePolicy.PolicyDocument' "$json_path" >"$tmp_inline"; then
            echo "Failed to extract InlinePolicy.PolicyDocument from $json_path" >&2
            [ -f "$tmp_inline" ] && rm -f "$tmp_inline"
            return 1
        fi

        # Validate extracted JSON
        if ! jq empty "$tmp_inline" >/dev/null 2>&1; then
            echo "Extracted InlinePolicy.PolicyDocument is not valid JSON" >&2
            rm -f "$tmp_inline"
            return 1
        fi

        aws iam put-role-policy \
            --role-name "$role_name" \
            --policy-name "$policy_name" \
            --policy-document "file://$tmp_inline"

        local status=$?
        if [ $status -eq 0 ]; then
            echo "Put inline policy '$policy_name' on role '$role_name' from '$json_path' (.InlinePolicy.PolicyDocument)"
            did_any_change=1
            rm -f "$tmp_inline" 2>/dev/null || true
        else
            rm -f "$tmp_inline" 2>/dev/null || true
            op_status=$status
        fi
    fi

    if [ $did_any_change -eq 0 ]; then
        echo "No changes made: '$json_path' contains no supported keys"
    fi
    return $op_status
}

iam_role_assume() {
    local help_text="Usage: iam role assume <role_name_or_arn>

    Assume the specified IAM role and output temporary credential export lines.

    Arguments:
    role_name_or_arn  Role name (in current account) or full role ARN

    Options:
    --help        Display this help message

    Output:
    Shell export lines for AWS credentials suitable for eval or source.

    Examples:
    eval \$(iam role assume MyRole)
    iam role assume arn:aws:iam::123456789012:role/MyRole | source
    "

    if [[ "$1" == "--help" ]]; then
        echo "$help_text"
        return 0
    fi

    if [ -z "$1" ]; then
        echo "$help_text"
        return 1
    fi

    local input="$1"
    local role_arn="$input"
    if [[ ! "$input" =~ ^arn:aws:iam::[0-9]{12}:role/ ]]; then
        # Construct ARN from current account id
        local account_id
        account_id=$(aws --output json sts get-caller-identity --query Account 2>/dev/null | jq -r)
        if [ -z "$account_id" ] || [ "$account_id" = "null" ]; then
            echo "Failed to determine AWS account ID to build role ARN" >&2
            return 1
        fi
        role_arn="arn:aws:iam::${account_id}:role/${input}"
    fi

    local session_name
    session_name="iam-role-assume-$(whoami 2>/dev/null || echo user)-$(date +%s)"

    local resp
    if ! resp=$(aws --output json sts assume-role --role-arn "$role_arn" --role-session-name "$session_name" 2>/dev/null); then
        echo "Failed to assume role: $role_arn" >&2
        return 1
    fi

    echo "export AWS_ACCESS_KEY_ID=$(echo "$resp" | jq -r '.Credentials.AccessKeyId')"
    echo "export AWS_SECRET_ACCESS_KEY=$(echo "$resp" | jq -r '.Credentials.SecretAccessKey')"
    echo "export AWS_SESSION_TOKEN=$(echo "$resp" | jq -r '.Credentials.SessionToken')"
    echo "export AWS_SECURITY_TOKEN=$(echo "$resp" | jq -r '.Credentials.SessionToken')"
}

iam_role_delete() {
    # Delete an IAM role by name, cleaning up attachments first.
    # Usage: iam role --delete <role_name>
    local role_name="$1"

    if [ -z "$role_name" ]; then
        echo "Error: role name is required for --delete" >&2
        return 1
    fi

    # Detach attached managed policies
    local attached_json
    if attached_json=$(aws --output json iam list-attached-role-policies --role-name "$role_name" 2>/dev/null); then
        echo "$attached_json" | jq -r '.AttachedPolicies[]?.PolicyArn' | while read -r arn; do
            [ -z "$arn" ] && continue
            aws iam detach-role-policy --role-name "$role_name" --policy-arn "$arn" >/dev/null 2>&1 || true
        done
    fi

    # Delete inline policies
    local inline_json
    if inline_json=$(aws --output json iam list-role-policies --role-name "$role_name" 2>/dev/null); then
        echo "$inline_json" | jq -r '.PolicyNames[]?' | while read -r pname; do
            [ -z "$pname" ] && continue
            aws iam delete-role-policy --role-name "$role_name" --policy-name "$pname" >/dev/null 2>&1 || true
        done
    fi

    # Remove from instance profiles
    local profiles_json
    if profiles_json=$(aws --output json iam list-instance-profiles-for-role --role-name "$role_name" 2>/dev/null); then
        echo "$profiles_json" | jq -r '.InstanceProfiles[]?.InstanceProfileName' | while read -r ipname; do
            [ -z "$ipname" ] && continue
            aws iam remove-role-from-instance-profile --instance-profile-name "$ipname" --role-name "$role_name" >/dev/null 2>&1 || true
        done
    fi

    # Finally, delete role
    if aws iam delete-role --role-name "$role_name"; then
        echo "Deleted role '$role_name'"
        return 0
    else
        echo "Failed to delete role '$role_name'" >&2
        return 1
    fi
}

iam_role() {
    local help_text="Usage: iam role [role_name]

    iam role --delete <role_name>
    iam role update <role_name> <json_path>
    iam role assume <role_name_or_arn>

    Without a role name, a list of IAM roles is returned. If a role name is provided, details of the role are returned.

    Additionally:
    - To view attached policies, use 'iam policy'.
    - To view role-specific inline policies, use 'iam role-policy'.
    - To update a role's trust policy, use 'iam role update'.
    - To assume a role and emit credentials, use 'iam role assume'.

    Options:
    --help        Display this help message
    --delete      Delete the specified role (detaches policies and removes from instance profiles first)"

    # Subcommands take precedence so their --help is respected
    if [ "$1" = "assume" ]; then
        shift
        iam_role_assume "$@"
        return $?
    fi
    if [ "$1" = "update" ]; then
        shift
        iam_role_update "$@"
        return $?
    fi

    # Support delete flag either before or after the role name
    if [ "$1" = "--delete" ] || [ "$2" = "--delete" ]; then
        # Determine role name position
        local rn
        if [ "$1" = "--delete" ]; then
            rn="$2"
        else
            rn="$1"
        fi
        iam_role_delete "$rn"
        return $?
    fi

    if [[ "$*" == *"--help"* ]]; then
        echo "$help_text"
        return 0
    fi

    if [ -z "$1" ]; then
        # List unique role identifiers. Previously this parsed the ARN path and
        # printed the first segment after 'role/', which resulted in many lines
        # showing just 'service-role' or 'aws-service-role'. The RoleName field
        # is already unique within an account, so list that instead.
        aws --output json iam list-roles | jq -r '.Roles[].RoleName'
    else
        role_name="$1"

        attached_policies=$(aws --output json iam list-attached-role-policies --role-name "$role_name" &)
        role_policies=$(aws --output json iam list-role-policies --role-name "$role_name" | jq -cr '.PolicyNames' &)
        get_role=$(aws --output json iam get-role --role-name "$role_name" | jq '.Role')

        wait

        echo "$get_role" |
            jq --argjson rp "$role_policies" '. + {"RolePolicies": $rp}' |
            jq ". + {AttachedPolicies: $attached_policies}"
    fi
}

iam_policy() {
    local help_text="Usage: iam policy [policyArn]

    Without a policy ARN, a list of IAM policies is returned. If an ARN is provided, the policy document of the latest version is returned.

    Arguments:
    policyArn     ARN of the IAM policy

    Options:
    --help        Display this help message"

    if [[ "$*" == *"--help"* ]]; then
        echo "$help_text"
        return 0
    fi

    if [ -z "$1" ]; then
        aws iam list-policies --query 'Policies[*].[PolicyName, Arn, DefaultVersionId]'
    else
        arn="$1"
        versionId=$(aws --output json iam get-policy --policy-arn "$arn" --query 'Policy.DefaultVersionId' | jq -r)
        aws --output json iam get-policy-version --policy-arn "$arn" --version-id "$versionId" --query 'PolicyVersion.Document' | jq
    fi
}

# Dispatcher function
iam() {
    local command="$1"
    shift

    case "$command" in
    role)
        iam_role "$@"
        ;;
    role-policy)
        iam_role_policy "$@"
        ;;
    policy)
        iam_policy "$@"
        ;;
    -h | --help | '')
        iam_help
        ;;
    *)
        echo "Unknown command: $command"
        iam_help
        return 1
        ;;
    esac
}

# If the script is executed directly, pass all arguments to the dispatcher
iam "$@"
